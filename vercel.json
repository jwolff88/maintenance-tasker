{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "cd /vercel/path0 && npm run build -w backend && npm run build -w frontend",
  "installCommand": "npm install --workspaces --include-workspace-root --include=dev",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.ts": {
      "runtime": "@vercel/node@3.2.0",
      "includeFiles": "backend/build/**,node_modules/.prisma/**,node_modules/@prisma/client/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/((?!api|assets|favicon).*)", "destination": "/index.html" }
  ]
}
