generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Subscription plans
enum SubscriptionPlan {
  TRIAL
  STARTER
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
}

// Multi-tenant company
model Company {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Subscription & Billing
  stripeCustomerId     String?           @unique
  stripeSubscriptionId String?           @unique
  plan                 SubscriptionPlan  @default(TRIAL)
  subscriptionStatus   SubscriptionStatus @default(TRIALING)
  trialEndsAt          DateTime?
  currentPeriodEnd     DateTime?

  users      User[]
  properties Property[]
  vendors    Vendor[]
  assets     Asset[]
  tasks      Task[]
  capitalExpenditures CapitalExpenditure[]
  turnovers  Turnover[]
}

enum UserRole {
  SUPER_ADMIN
  COMPANY_ADMIN
  PROPERTY_MANAGER
  MAINTENANCE_STAFF
  VENDOR
  READ_ONLY
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  role         UserRole @default(READ_ONLY)
  phone        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Custom permissions (JSON) - overrides role-based defaults
  // Structure: { properties: { view, create, edit, delete }, tasks: {...}, etc. }
  permissions  Json?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  managedProperties Property[]         @relation("PropertyManager")
  tickets           MaintenanceTicket[] @relation("TicketCreator")
  assignedTickets   MaintenanceTicket[] @relation("TicketAssignee")
  notes             Note[]
  activityLogs      ActivityLog[]

  // Maintenance Tasker relations
  assignedTasks     Task[]           @relation("TaskAssignee")
  createdTasks      Task[]           @relation("TaskCreator")
  taskComments      TaskComment[]    @relation("TaskCommentAuthor")

  @@index([companyId])
}

enum PropertyStatus {
  HEALTHY
  ATTENTION_NEEDED
  CRITICAL
}

enum PropertyType {
  SINGLE_FAMILY
  MULTI_FAMILY
  APARTMENT
  CONDO
  TOWNHOUSE
  COMMERCIAL
}

model Property {
  id          String         @id @default(uuid())
  name        String
  address     String
  city        String
  state       String
  zipCode     String
  type        PropertyType
  units       Int            @default(1)
  sqft        Int?
  yearBuilt   Int?
  status      PropertyStatus @default(HEALTHY)
  riskScore   Int            @default(0) // 0-100 predictive maintenance score
  occupancy   Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  managerId String?
  manager   User?   @relation("PropertyManager", fields: [managerId], references: [id])

  ownerId String?
  owner   PropertyOwner? @relation(fields: [ownerId], references: [id])

  leases         Lease[]
  tickets        MaintenanceTicket[]
  notes          Note[]
  inspections    Inspection[]
  equipment      Equipment[]
  activityLogs   ActivityLog[]
  events         PropertyEvent[]
  assets         Asset[]
  capitalExpenditures CapitalExpenditure[]
  turnovers      Turnover[]

  @@index([companyId])
  @@index([managerId])
  @@index([status])
}

model PropertyOwner {
  id        String   @id @default(uuid())
  firstName String
  lastName  String
  email     String
  phone     String?
  address   String?
  notes     String?  // Owner preferences, approval rules
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  properties Property[]
}

enum NoteType {
  PROPERTY
  TENANT
  BUILDING
  OWNER
}

model Note {
  id          String   @id @default(uuid())
  content     String
  type        NoteType
  isInternal  Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  attachments Attachment[]

  @@index([propertyId, type])
}

model Attachment {
  id        String   @id @default(uuid())
  filename  String
  url       String
  mimeType  String
  size      Int
  createdAt DateTime @default(now())

  noteId   String?
  note     Note?   @relation(fields: [noteId], references: [id], onDelete: Cascade)

  ticketId String?
  ticket   MaintenanceTicket? @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

model Tenant {
  id        String   @id @default(uuid())
  firstName String
  lastName  String
  email     String
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leases  Lease[]
  tickets MaintenanceTicket[]
}

enum LeaseStatus {
  ACTIVE
  EXPIRED
  TERMINATED
  PENDING
}

model Lease {
  id            String      @id @default(uuid())
  startDate     DateTime
  endDate       DateTime
  rentAmount    Decimal     @db.Decimal(10, 2)
  depositAmount Decimal     @db.Decimal(10, 2)
  status        LeaseStatus @default(PENDING)
  terms         String?     // Special terms
  renewalProb   Int         @default(50) // 0-100 renewal probability
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@index([propertyId])
  @@index([endDate])
  @@index([status])
}

enum TicketStatus {
  NEW
  IN_PROGRESS
  WAITING_ON_TENANT
  WAITING_ON_VENDOR
  COMPLETED
  CANCELLED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketCategory {
  PLUMBING
  ELECTRICAL
  HVAC
  APPLIANCE
  STRUCTURAL
  PEST_CONTROL
  LANDSCAPING
  CLEANING
  SAFETY
  OTHER
}

model MaintenanceTicket {
  id              String         @id @default(uuid())
  title           String
  description     String
  status          TicketStatus   @default(NEW)
  priority        TicketPriority @default(MEDIUM)
  category        TicketCategory @default(OTHER)
  estimatedCost   Decimal?       @db.Decimal(10, 2)
  actualCost      Decimal?       @db.Decimal(10, 2)
  slaDeadline     DateTime?
  completedAt     DateTime?
  suggestedFix    String?        // AI-suggested fix
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  creatorId String
  creator   User   @relation("TicketCreator", fields: [creatorId], references: [id])

  assigneeId String?
  assignee   User?   @relation("TicketAssignee", fields: [assigneeId], references: [id])

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  vendorId String?
  vendor   Vendor? @relation(fields: [vendorId], references: [id])

  attachments Attachment[]
  comments    TicketComment[]

  @@index([propertyId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
}

model TicketComment {
  id        String   @id @default(uuid())
  content   String
  isInternal Boolean @default(false)
  createdAt DateTime @default(now())

  ticketId String
  ticket   MaintenanceTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  authorId String
}

model Vendor {
  id                 String   @id @default(uuid())
  name               String
  email              String
  phone              String?
  specialties        String[] // e.g., ["plumbing", "hvac"]
  insuranceExpiry    DateTime?
  licenseNumber      String?
  rating             Decimal  @default(0) @db.Decimal(2, 1) // 0.0-5.0
  totalJobs          Int      @default(0)
  avgResponseTime    Int?     // in hours
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  tickets MaintenanceTicket[]
  capitalExpenditures CapitalExpenditure[]

  @@index([companyId])
}

enum InspectionType {
  CITY
  FIRE
  SAFETY
  ROUTINE
  MOVE_IN
  MOVE_OUT
}

enum InspectionStatus {
  SCHEDULED
  COMPLETED
  FAILED
  CANCELLED
}

model Inspection {
  id           String           @id @default(uuid())
  type         InspectionType
  status       InspectionStatus @default(SCHEDULED)
  scheduledAt  DateTime
  completedAt  DateTime?
  notes        String?
  passedItems  String[]
  failedItems  String[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([scheduledAt])
}

model Equipment {
  id                String    @id @default(uuid())
  name              String
  type              String    // e.g., "HVAC", "Water Heater"
  manufacturer      String?
  model             String?
  serialNumber      String?
  installDate       DateTime?
  warrantyExpiry    DateTime?
  lastServiceDate   DateTime?
  nextServiceDate   DateTime?
  expectedLifespan  Int?      // in years
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([nextServiceDate])
}

enum EventType {
  INSPECTION
  LEASE_EXPIRY
  WARRANTY_EXPIRY
  SCHEDULED_MAINTENANCE
  COMPLIANCE_DEADLINE
}

model PropertyEvent {
  id          String    @id @default(uuid())
  title       String
  type        EventType
  date        DateTime
  description String?
  isCompleted Boolean   @default(false)
  createdAt   DateTime  @default(now())

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([date])
}

model ActivityLog {
  id        String   @id @default(uuid())
  action    String
  details   String?
  createdAt DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([createdAt])
}

// ============================================
// MAINTENANCE TASKER - Asset & Task Management
// ============================================

enum AssetStatus {
  OPERATIONAL
  NEEDS_MAINTENANCE
  OUT_OF_SERVICE
  RETIRED
}

enum AssetCategory {
  ELECTRICAL
  PLUMBING
  HVAC
  MECHANICAL
  SAFETY
  STRUCTURAL
  IT_EQUIPMENT
  VEHICLES
  OTHER
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  UNDER_REVIEW
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RecurrenceType {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
  CUSTOM
}

model Asset {
  id          String        @id @default(uuid())
  name        String
  description String?
  category    AssetCategory @default(OTHER)
  location    String?
  qrCode      String?       @unique
  status      AssetStatus   @default(OPERATIONAL)
  manufacturer String?
  model        String?
  serialNumber String?
  purchaseDate DateTime?
  warrantyExpiry DateTime?
  notes        String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id])

  tasks Task[]

  @@index([companyId])
  @@index([status])
  @@index([category])
}

model Task {
  id            String       @id @default(uuid())
  title         String
  description   String?
  status        TaskStatus   @default(OPEN)
  priority      TaskPriority @default(MEDIUM)
  dueDate       DateTime?
  startedAt     DateTime?
  completedAt   DateTime?
  photoBefore   String?      // URL to before photo
  photoAfter    String?      // URL to after photo
  notes         String?
  estimatedTime Int?         // in minutes
  actualTime    Int?         // in minutes

  // Recurrence
  isRecurring     Boolean        @default(false)
  recurrenceType  RecurrenceType?
  recurrenceValue Int?           // e.g., 30 for "every 30 days"
  nextDueDate     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  assignedToId String?
  assignedTo   User?   @relation("TaskAssignee", fields: [assignedToId], references: [id])

  createdById String
  createdBy   User   @relation("TaskCreator", fields: [createdById], references: [id])

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  comments TaskComment[]

  @@index([companyId])
  @@index([assetId])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@index([assignedToId])
}

model TaskComment {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation("TaskCommentAuthor", fields: [authorId], references: [id])

  @@index([taskId])
}

// ============================================
// CAPITAL EXPENDITURES (CapEx)
// ============================================

enum CapExCategory {
  ROOF
  HVAC
  PLUMBING
  ELECTRICAL
  STRUCTURAL
  APPLIANCES
  FLOORING
  EXTERIOR
  LANDSCAPING
  RENOVATION
  OTHER
}

enum CapExStatus {
  PROPOSED
  PENDING_APPROVAL
  APPROVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model CapitalExpenditure {
  id              String        @id @default(uuid())
  title           String
  description     String?
  category        CapExCategory @default(OTHER)
  status          CapExStatus   @default(PROPOSED)

  // Financial
  estimatedCost   Decimal       @db.Decimal(12, 2)
  actualCost      Decimal?      @db.Decimal(12, 2)
  budgetYear      Int           // Fiscal year

  // Approval
  approvedById    String?
  approvedAt      DateTime?

  // Timeline
  proposedDate    DateTime      @default(now())
  startDate       DateTime?
  completionDate  DateTime?

  // Accounting
  depreciationYears Int?        // Years to depreciate asset

  // Notes & attachments
  notes           String?
  attachments     String[]      // URLs to documents/photos

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  vendorId String?
  vendor   Vendor? @relation(fields: [vendorId], references: [id])

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([propertyId])
  @@index([status])
  @@index([budgetYear])
}

// ============================================
// UNIT TURNOVERS
// ============================================

enum TurnoverStatus {
  SCHEDULED
  MOVE_OUT_COMPLETE
  IN_PROGRESS
  FINAL_INSPECTION
  READY
  OCCUPIED
  CANCELLED
}

model Turnover {
  id                  String         @id @default(uuid())
  unit                String?        // Unit number for multi-unit properties
  status              TurnoverStatus @default(SCHEDULED)

  // Dates
  moveOutDate         DateTime
  targetReadyDate     DateTime       // Target date for make-ready
  actualReadyDate     DateTime?
  moveInDate          DateTime?      // New tenant move-in

  // Vacancy tracking
  daysVacant          Int?           // Auto-calculated or manual

  // Costs
  estimatedCost       Decimal?       @db.Decimal(10, 2)
  actualCost          Decimal?       @db.Decimal(10, 2)

  // Lease references
  outgoingLeaseId     String?
  incomingLeaseId     String?

  // Inspection results
  moveOutNotes        String?
  moveOutPhotos       String[]       // URLs
  moveInNotes         String?
  moveInPhotos        String[]       // URLs

  // Security deposit
  depositDeductions   Decimal?       @db.Decimal(10, 2)
  depositNotes        String?

  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  turnoverTasks TurnoverTask[]

  @@index([companyId])
  @@index([propertyId])
  @@index([status])
  @@index([moveOutDate])
}

enum TurnoverTaskCategory {
  CLEANING
  PAINTING
  REPAIRS
  INSPECTION
  APPLIANCES
  FLOORING
  LOCKS
  LANDSCAPING
  OTHER
}

enum TurnoverTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

model TurnoverTask {
  id          String               @id @default(uuid())
  title       String
  description String?
  category    TurnoverTaskCategory @default(OTHER)
  status      TurnoverTaskStatus   @default(PENDING)

  estimatedCost Decimal?           @db.Decimal(10, 2)
  actualCost    Decimal?           @db.Decimal(10, 2)

  completedAt DateTime?
  notes       String?
  photos      String[]             // Before/after photos

  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  turnoverId String
  turnover   Turnover @relation(fields: [turnoverId], references: [id], onDelete: Cascade)

  assigneeId String?

  vendorId   String?

  @@index([turnoverId])
  @@index([status])
}
